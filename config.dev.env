# WARN: For some distros >1024 is privileged and can't be used for example NixOS

PROJ_DIR=/root/Leams

#PORTS
NGINX_REVERSE_PORT_HTTP=80
NGINX_REVERSE_PORT_HTTPS=443
NGINX_RTMP_PORT=1935

# CONF PATH
NGINX_CONF_PATH=./nginx/local/nginx.conf.template
SELFSIGNED_KEY_PATH=./nginx/local/nginx-selfsigned.key;
SELFSIGNED_CERT_PATH=./nginx/local/nginx-selfsigned.crt;

#NGINX CONF
SERVER_HTTP_PORT=80
SERVER_HTTPS_PORT=443
DOMAIN_NAME=localhost
FRONTEND_PORT=3000
BACKEND_PORT=8000
DOCS_PORT=8000
DATABASE_PORT=5432
MOBILE_PORT=3000
REDIS_PORT=6379
NGINX_RTMP_PORT=1935

# WARN: THESE settings must stand AFTER DOMAIN_NAME or it will be NONE
NGINX_SSL_CERT_PATH=nginx-selfsigned.crt;
NGINX_SSL_KEY_PATH=nginx-selfsigned.key;

# WARN: Update sub domain in domain seller sites

#SUBDOMAINS
SUB_BACKEND=api
SUB_DOCS=docs
SUB_STREAM=stream

#NAMES
COMPOSE_FRONTEND_NAME=frontend
COMPOSE_NGINX_REVERSE_NAME=nginx-reverse
COMPOSE_DOCS_NAME=docs
COMPOSE_DATABASE_NAME=database
COMPOSE_BACKEND_NAME=backend-python
COMPOSE_MOBILE_NAME=mob
COMPOSE_NGINX_RTMP_NAME=nginx-rtmp
REDIS_NAME=redis

DOMAIN_EMAIL="example@gmail.com"

#DATABASE
POSTGRES_USER="postgres"
POSTGRES_PASSWORD="secret"
DATABASE_HOST="database"
POSTGRES_DB="leams"
