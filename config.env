#PORTS
NGINX_REVERSE_PORT_HTTP=80
NGINX_REVERSE_PORT_HTTPS=443
NGINX_RTMP_PORT=1935

#NGINX CONF
SERVER_HTTP_PORT=80
SERVER_HTTPS_PORT=443
DOMAIN_NAME=localhost
FRONTEND_PORT=3000
BACKEND_PORT=8000
DOCS_PORT=8000
MOBILE_PORT=3000
REDIS_PORT=6379

#SUBDOMAINS
SUB_BACKEND=api
SUB_DOCS=docs
SUB_MOBILE=mob

#NAMES
COMPOSE_FRONTEND_NAME=frontend
COMPOSE_NGINX_REVERSE_NAME=nginx-reverse
COMPOSE_DOCS_NAME=docs
