# WARN:Before read this read about certbot usage or just make 
worker_processes  1;

events {
  worker_connections 1024;
}


http {
  # https://www.cloudflare.com/ips/
	set_real_ip_from 2400:cb00::/32 2606:4700::/32 2803:f800::/32 2405:b500::/32 2405:8100::/32 2a06:98c0::/29 2c0f:f248::/32173.245.48.0/20 103.21.244.0/22 103.22.200.0/22 103.31.4.0/22 141.101.64.0/18 108.162.192.0/18 190.93.240.0/20 188.114.96.0/20 197.234.240.0/22 198.41.128.0/17 162.158.0.0/15 104.16.0.0/13 104.24.0.0/14 172.64.0.0/13 131.0.72.0/22;
	real_ip_recursive on;
	real_ip_header X-Forwarded-For;
  server {
    listen 80;
    server_name         ${DOMAIN_NAME} www.${DOMAIN_NAME};
    location /.well-known/acme-challenge/ {
        root /var/www/certbot;
    }

    location / {
        return 301 https://${DOMAIN_NAME};
        allow all;
    }

  }
  server {
    listen 80;
    server_name         ${SUB_DOCS}.${DOMAIN_NAME};
    location /.well-known/acme-challenge/ {
        root /var/www/certbot;
    
    location / {
        return 301 https://$host$request_uri;
        allow all;
    }

  }

  server {
    listen 80;
    server_name         ${SUB_BACKEND}.${DOMAIN_NAME};
    location /.well-known/acme-challenge/ {
        root /var/www/certbot;
    }

    location / {
        return 301 https://$host$request_uri;
        allow all;
    }

  }
  server {
    listen ${SERVER_HTTPS_PORT} ssl;
    listen [::]:${SERVER_HTTPS_PORT} ssl;
    root /var/www/${DOMAIN_NAME};
    http2 on;
    server_name ${DOMAIN_NAME} www.${DOMAIN_NAME};
    ssl_certificate ${NGINX_SSL_CERT_PATH};
    ssl_certificate_key ${NGINX_SSL_KEY_PATH};

		# NOTE: This for cloudflare

    allow 217.77.54.234;
    allow 2a13:7e40:3:303b::1;
    allow 138.124.81.60;
    deny all;
    deny all;
    ssl_protocols TLSv1.2 TLSv1.3;
    add_header Access-Control-Allow-Origin *;
    ssl_ciphers 'ECDHE-ECDSA-AES128-GCM-SHA256:ECDHE-RSA-AES128-GCM-SHA256:ECDHE-ECDSA-AES256-GCM-SHA384:ECDHE-RSA-AES256-GCM-SHA384';
    ssl_prefer_server_ciphers off;
    ssl_session_cache shared:SSL:10m;
    ssl_session_timeout 10m;
    location / {
			proxy_pass http://${FRONTEND_NAME}:${FRONTEND_PORT};
    }
  }

  server {
    listen ${SERVER_HTTPS_PORT} ssl;
    listen [::]:${SERVER_HTTPS_PORT} ssl;
    http2 on;
    root /var/www/${DOMAIN_NAME};
    server_name         ${SUB_DOCS}.${DOMAIN_NAME};
    ssl_certificate     /etc/letsencrypt/live/${DOMAIN_NAME}/fullchain.pem;
    ssl_certificate_key /etc/letsencrypt/live/${DOMAIN_NAME}/privkey.pem;
    ssl_protocols       TLSv1.2 TLSv1.3;
    add_header Access-Control-Allow-Origin *;
    ssl_ciphers 'ECDHE-ECDSA-AES128-GCM-SHA256:ECDHE-RSA-AES128-GCM-SHA256:ECDHE-ECDSA-AES256-GCM-SHA384:ECDHE-RSA-AES256-GCM-SHA384';
    ssl_prefer_server_ciphers off;
    ssl_session_cache shared:SSL:10m;
    add_header Access-Control-Allow-Origin *;
    location / {
      proxy_pass http://${DOCS_NAME}:${DOCS_PORT};
    }
  }
}

